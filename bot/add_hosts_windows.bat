@echo off
chcp 65001 >nul
setlocal enabledelayedexpansion

:: ============================================
::  Настройки (измените IP и домен при необходимости)
:: ============================================
set "IP=2.26.138.90"
set "DOMAIN=thenomoreblocks.com"
set "HOSTS=%SystemRoot%\System32\drivers\etc\hosts"

:: ============================================
::  Проверка прав администратора
:: ============================================
echo [1/4] Проверка прав администратора...
net session >nul 2>&1
if %errorLevel% neq 0 (
    echo.
    echo [ОШИБКА] Запустите файл от имени администратора!
    echo.
    echo Способ 1: Нажмите правой кнопкой мыши на файле
    echo          и выберите "Запуск от имени администратора".
    echo.
    echo Способ 2: Нажмите Win+R, введите cmd,
    echo          нажмите Ctrl+Shift+Enter и запустите скрипт.
    echo.
    pause
    exit /b 1
)
echo [OK] Права администратора получены.
echo.

:: ============================================
::  Поиск существующей записи
:: ============================================
echo [2/4] Проверка наличия записи в файле hosts...
findstr /i /c:"%DOMAIN%" "%HOSTS%" >nul
if %errorLevel% equ 0 (
    echo [ВНИМАНИЕ] Запись для %DOMAIN% уже существует.
    echo.
    echo Текущая запись:
    findstr /i /c:"%DOMAIN%" "%HOSTS%"
    echo.
    echo Хотите обновить IP-адрес (перезаписать)?
    choice /C YN /M "Нажмите Y (Да) или N (Нет)"
    if errorlevel 2 (
        echo Отмена. Запись не изменена.
        pause
        exit /b 0
    )
    echo Удаление старой записи...
    findstr /v /i /c:"%DOMAIN%" "%HOSTS%" > "%HOSTS%.tmp"
    move "%HOSTS%.tmp" "%HOSTS%" >nul
    echo [OK] Старая запись удалена.
) else (
    echo [OK] Запись не найдена, будет добавлена новая.
)
echo.

:: ============================================
::  Добавление новой записи
:: ============================================
echo [3/4] Добавление записи в файл hosts...
echo %IP%    %DOMAIN% >> "%HOSTS%"
if %errorLevel% neq 0 (
    echo [ОШИБКА] Не удалось добавить запись.
    pause
    exit /b 1
)
echo [OK] Запись добавлена: %IP%    %DOMAIN%
echo.

:: ============================================
::  Сброс DNS-кэша
:: ============================================
echo [4/4] Сброс DNS-кэша...
ipconfig /flushdns >nul 2>&1
if %errorLevel% neq 0 (
    echo [ВНИМАНИЕ] Не удалось сбросить DNS-кэш.
    echo Попробуйте перезагрузить компьютер.
) else (
    echo [OK] DNS-кэш сброшен.
)
echo.

:: ============================================
::  Готово
:: ============================================
echo =============================================
echo  ГОТОВО! Сайт %DOMAIN% должен открываться!
echo =============================================
echo.
echo Если сайт всё ещё не открывается:
echo  1. Отключите VPN/прокси (если включены)
echo  2. Перезагрузите компьютер
echo  3. Попробуйте открыть сайт в другом браузере
echo.
echo Чтобы удалить запись, запустите скрипт:
echo  remove_hosts.bat (если создали)
echo.
pause