# --- База данных ---
DATABASE_URL=postgres://vpn_user:secure_password@postgres:5432/vpn_db?sslmode=disable
REDIS_URL=redis://redis:6379/0
DB_USER=vpn_user
DB_PASSWORD=secure_password
DB_NAME=vpn_db
# База панели 3x-ui в PostgreSQL (пароль в DSN должен быть URL-закодирован: + -> %2B, = -> %3D)
PANEL_DB_NAME=xui_panel
PANEL_DB_DSN=postgres://vpn_user:secure_password@postgres:5432/xui_panel?sslmode=disable

# --- JWT (обязательно задайте свои значения) ---
JWT_SECRET=change_me_strong_secret
# Сгенерируйте EC P-256 приватный ключ (PEM) и вставьте сюда,
# иначе ключи будут эфемерными и сбросятся при рестарте:
# JWT_PRIVATE_KEY=-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----


# Публичный Origin для ссылок подписки (домен/хост, видимый клиентам)
PUBLIC_ORIGIN=https://thenomoreblocks.com

# --- Бот ---
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
BOT_API_SECRET=dev_bot_secret_changeme
WEB_APP_URL=https://thenomoreblocks.com

# --- 3x-ui Panel ---
PANEL_URL=http://3xui:8383/x7kP9mQ/
PANEL_PUBLIC_URL=https://thenomoreblocks.com:2096/x7kP9mQ/
PANEL_USERNAME=admin
PANEL_PASSWORD=change_me
PANEL_API_TOKEN=
DEFAULT_GROUP=Free
DEFAULT_INBOUND_IDS=1
DEFAULT_SUBSCRIPTION_DAYS=2
EXPIRY_NOTIFY_DAYS=2
REFERRAL_REWARD_DAYS=7
REFERRAL_SIGNUP_BONUS_DAYS=2

# --- Прочее ---
APP_ENV=production
CORS_DOMAIN=https://thenomoreblocks.com

# --- ЮKassa (биллинг) ---
# Тестовый магазин: секретный ключ начинается с "test_". Для prod замените на боевой.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_URL=https://api.yookassa.ru/v3
# Куда вернуть пользователя после оплаты (по умолчанию PUBLIC_ORIGIN / WEB_APP_URL)
YOOKASSA_RETURN_URL=
